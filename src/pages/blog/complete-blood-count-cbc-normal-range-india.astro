---
import Layout from '../../frontend/layouts/Layout.astro';
import Header from '../../frontend/components/Header.astro';
import Footer from '../../frontend/components/Footer.astro';
import BlogShareBar from '../../frontend/components/BlogShareBar.astro';
import BlogBreadcrumbs from '../../frontend/components/BlogBreadcrumbs.astro';
---

<Layout 
  title="CBC Normal Range India 2025: Complete Blood Count Reference Values | HealthSaral"
  description="Complete reference ranges for all CBC parameters in India — WBC, RBC, Hemoglobin, Hematocrit, MCV, MCH, MCHC, Platelets. Gender-specific and age-based normal values for Indian patients."
>
  <Header />
  <BlogBreadcrumbs title="CBC Normal Range in India: Complete Blood Count Reference Values" slug="complete-blood-count-cbc-normal-range-india" />

  <main class="flex-grow">
    <section class="relative overflow-hidden bg-mesh-gradient pt-14 pb-16 px-4 sm:px-6 lg:px-8 border-b border-hairline">
      <div class="w-full max-w-3xl mx-auto text-center">
        <div class="flex flex-wrap justify-center gap-2 mb-6">
          <span class="text-[10px] font-mono text-primary bg-primary/5 border border-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wide">CBC</span>
          <span class="text-[10px] font-mono text-primary bg-primary/5 border border-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wide">Normal Range</span>
          <span class="text-[10px] font-mono text-primary bg-primary/5 border border-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wide">Reference Values</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-primary tracking-tight mb-4 text-balance">
          CBC Normal Range in India: Complete Blood Count Reference Values (2025)
        </h1>
        <p class="text-sm sm:text-base text-muted max-w-2xl mx-auto leading-relaxed">
          A quick reference guide to all Complete Blood Count (Haemogram) parameters with Indian laboratory reference ranges, gender-specific values, and what each abbreviation means.
        </p>
        <div class="flex items-center justify-center gap-4 mt-6 text-xs text-muted font-mono">
          <span>📅 Nov 5, 2026</span><span>•</span><span>⏱ 10 min read</span><span>•</span><span>✅ Doctor-Reviewed</span>
        </div>
      </div>
    </section>

    <article class="py-16 bg-canvas px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto prose dark:prose-invert prose-sm sm:prose-base font-sans text-ink leading-relaxed">

        <div class="bg-blue-50/50 dark:bg-blue-950/20 border border-blue-200/50 dark:border-blue-900/30 rounded-lg p-4 mb-8 text-sm text-blue-800 dark:text-blue-200">
          <strong>Quick Reference:</strong> This page provides a comprehensive table of CBC normal ranges used by major Indian diagnostic labs including Thyrocare, Dr Lal PathLabs, SRL Diagnostics, Apollo, and Metropolis. Reference ranges may vary slightly between labs due to differences in equipment and methodology.
        </div>

        <h2>Complete Blood Count (CBC) — Full Reference Table</h2>
        
        <div class="overflow-x-auto my-6">
          <table class="text-sm w-full border border-hairline rounded-lg overflow-hidden">
            <thead class="bg-canvas-soft">
              <tr>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline min-w-[120px]">Parameter</th>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline">Men</th>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline">Women</th>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline">Unit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr><td class="p-3 font-medium">Hemoglobin (Hb / HGB)</td><td class="p-3">13.0 – 17.5</td><td class="p-3">11.5 – 15.5</td><td class="p-3 text-muted">g/dL</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3 font-medium">RBC Count</td><td class="p-3">4.5 – 5.9</td><td class="p-3">4.0 – 5.2</td><td class="p-3 text-muted">million/µL</td></tr>
              <tr><td class="p-3 font-medium">Hematocrit (HCT / PCV)</td><td class="p-3">40 – 54</td><td class="p-3">36 – 48</td><td class="p-3 text-muted">%</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3 font-medium">MCV</td><td class="p-3" colspan="2">80 – 100</td><td class="p-3 text-muted">fL</td></tr>
              <tr><td class="p-3 font-medium">MCH</td><td class="p-3" colspan="2">27 – 33</td><td class="p-3 text-muted">pg</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3 font-medium">MCHC</td><td class="p-3" colspan="2">31.5 – 36</td><td class="p-3 text-muted">g/dL</td></tr>
              <tr><td class="p-3 font-medium">RDW</td><td class="p-3" colspan="2">11.5 – 14.5</td><td class="p-3 text-muted">%</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3 font-medium">Total WBC Count</td><td class="p-3" colspan="2">4,000 – 11,000</td><td class="p-3 text-muted">cells/µL</td></tr>
              <tr><td class="p-3 font-medium">Neutrophils</td><td class="p-3" colspan="2">40 – 75</td><td class="p-3 text-muted">%</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3 font-medium">Lymphocytes</td><td class="p-3" colspan="2">20 – 45</td><td class="p-3 text-muted">%</td></tr>
              <tr><td class="p-3 font-medium">Monocytes</td><td class="p-3" colspan="2">2 – 10</td><td class="p-3 text-muted">%</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3 font-medium">Eosinophils</td><td class="p-3" colspan="2">1 – 6</td><td class="p-3 text-muted">%</td></tr>
              <tr><td class="p-3 font-medium">Basophils</td><td class="p-3" colspan="2">0 – 1</td><td class="p-3 text-muted">%</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3 font-medium">Platelet Count (PLT)</td><td class="p-3" colspan="2">1,50,000 – 4,00,000</td><td class="p-3 text-muted">/µL</td></tr>
              <tr><td class="p-3 font-medium">MPV (Mean Platelet Volume)</td><td class="p-3" colspan="2">7.5 – 12.5</td><td class="p-3 text-muted">fL</td></tr>
            </tbody>
          </table>
        </div>

        <h2>CBC Abbreviation Dictionary</h2>
        <p>Blood reports use abbreviations that can be confusing. Here is a plain-language guide:</p>

        <div class="grid sm:grid-cols-2 gap-4 my-6">
          <div class="border border-hairline rounded-lg p-4">
            <h3 class="text-primary font-semibold mb-3 text-sm">Red Blood Cell Parameters</h3>
            <ul class="text-xs space-y-2 m-0 list-none p-0">
              <li><strong>Hb/HGB</strong> — Hemoglobin (oxygen-carrying protein)</li>
              <li><strong>RBC</strong> — Red Blood Cell count</li>
              <li><strong>HCT/PCV</strong> — Hematocrit/Packed Cell Volume (% of blood that is RBCs)</li>
              <li><strong>MCV</strong> — Mean Corpuscular Volume (average RBC size)</li>
              <li><strong>MCH</strong> — Mean Corpuscular Hemoglobin (average Hb per RBC)</li>
              <li><strong>MCHC</strong> — Mean Corpuscular Hemoglobin Concentration</li>
              <li><strong>RDW</strong> — Red Cell Distribution Width (variation in RBC size)</li>
            </ul>
          </div>
          <div class="border border-hairline rounded-lg p-4">
            <h3 class="text-primary font-semibold mb-3 text-sm">White Blood Cell & Platelet Parameters</h3>
            <ul class="text-xs space-y-2 m-0 list-none p-0">
              <li><strong>WBC/TLC</strong> — White Blood Cell / Total Leucocyte Count</li>
              <li><strong>DLC</strong> — Differential Leucocyte Count (breakdown by type)</li>
              <li><strong>Neutrophils (N)</strong> — Fight bacterial infections</li>
              <li><strong>Lymphocytes (L)</strong> — Fight viral infections</li>
              <li><strong>Monocytes (M)</strong> — Early immune responders</li>
              <li><strong>Eosinophils (E)</strong> — Allergy/parasite markers</li>
              <li><strong>PLT</strong> — Platelets (clotting cells)</li>
              <li><strong>MPV</strong> — Mean Platelet Volume</li>
            </ul>
          </div>
        </div>

        <h2>Age-Specific Normal Ranges (CBC India)</h2>
        <div class="overflow-x-auto my-6">
          <table class="text-sm w-full border border-hairline rounded-lg overflow-hidden">
            <thead class="bg-canvas-soft">
              <tr>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline">Age Group</th>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline">Hb (g/dL)</th>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline">WBC (/µL)</th>
                <th class="text-left p-3 font-semibold text-primary border-b border-hairline">Platelets (/µL)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr><td class="p-3">Newborn (0–2 weeks)</td><td class="p-3">14.5 – 22.5</td><td class="p-3">9,000 – 30,000</td><td class="p-3">1,50,000 – 4,50,000</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3">Infant (2m – 2yr)</td><td class="p-3">10.5 – 14.0</td><td class="p-3">6,000 – 17,000</td><td class="p-3">2,00,000 – 5,00,000</td></tr>
              <tr><td class="p-3">Children (2 – 12 yr)</td><td class="p-3">11.5 – 15.5</td><td class="p-3">5,000 – 13,000</td><td class="p-3">1,50,000 – 4,00,000</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3">Adolescent Boys</td><td class="p-3">13.0 – 16.5</td><td class="p-3">4,500 – 11,000</td><td class="p-3">1,50,000 – 4,00,000</td></tr>
              <tr><td class="p-3">Adolescent Girls</td><td class="p-3">12.0 – 16.0</td><td class="p-3">4,500 – 11,000</td><td class="p-3">1,50,000 – 4,00,000</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3">Adult Men</td><td class="p-3">13.0 – 17.5</td><td class="p-3">4,000 – 11,000</td><td class="p-3">1,50,000 – 4,00,000</td></tr>
              <tr><td class="p-3">Adult Women</td><td class="p-3">11.5 – 15.5</td><td class="p-3">4,000 – 11,000</td><td class="p-3">1,50,000 – 4,00,000</td></tr>
              <tr class="bg-canvas-soft/50"><td class="p-3">Pregnant Women (1st tri)</td><td class="p-3">≥ 11.0</td><td class="p-3">6,000 – 16,000</td><td class="p-3">1,50,000 – 4,00,000</td></tr>
              <tr><td class="p-3">Elderly (65+ yrs)</td><td class="p-3">12.0 – 17.0</td><td class="p-3">3,500 – 10,500</td><td class="p-3">1,50,000 – 4,00,000</td></tr>
            </tbody>
          </table>
        </div>

        <h2>Common CBC Patterns and Their Meaning</h2>
        <ul>
          <li><strong>Low Hb + Low MCV + Low Ferritin:</strong> Iron deficiency anemia (most common in India)</li>
          <li><strong>Low Hb + High MCV + Low B12:</strong> Megaloblastic (B12/Folate deficiency) anemia</li>
          <li><strong>Low Hb + Normal MCV + Normal Iron:</strong> Anemia of chronic disease</li>
          <li><strong>High WBC + High Neutrophils:</strong> Bacterial infection</li>
          <li><strong>Low WBC + Low Platelets:</strong> Dengue fever (common in India, especially monsoon)</li>
          <li><strong>High Eosinophils (&gt;6%):</strong> Allergy, asthma, or parasitic infection</li>
          <li><strong>Low Platelets (&lt;1,50,000):</strong> Dengue, ITP, or bone marrow issue</li>
        </ul>

        <div class="border border-primary/20 bg-primary/5 rounded-lg p-6 my-8 text-center">
          <p class="text-primary font-display font-semibold text-lg mb-2">Instant AI explanation of your CBC report</p>
          <p class="text-sm text-muted mb-4">Don't just look up values in a table — get a personalized, contextualized explanation of your entire CBC result. Upload your report to HealthSaral for free.</p>
          <a href="/#upload-section" class="inline-block px-6 py-3 bg-accent hover:bg-accent/90 text-white font-sans font-medium text-sm rounded-full shadow-sm transition-all">
            Analyze My CBC Report Free →
          </a>
        </div>

      </div>
    </article>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <BlogShareBar title="CBC Normal Range in India: Complete Blood Count Reference Values" url="https://healthsaral.in/blog/complete-blood-count-cbc-normal-range-india/" />
    </div>

    <section class="py-12 bg-canvas-soft border-t border-hairline px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
