---
import Layout from '../../frontend/layouts/Layout.astro';
import Header from '../../frontend/components/Header.astro';
import Footer from '../../frontend/components/Footer.astro';

const tools = [
  {
    slug: "bmi-calculator",
    title: "Asian-Indian BMI & Health Risk Calculator",
    description: "Calculate your Body Mass Index using ICMR & WHO Asia-Pacific cutoffs tailored for Indian body composition. Understand visceral fat risks and ideal weight.",
    badge: "ICMR & WHO Consensus",
    icon: "⚖️",
    features: ["Metric & Imperial units", "Indian specific cutoffs (Normal: 18.5 - 22.9)", "Cardiometabolic risk assessment"]
  },
  {
    slug: "hba1c-converter",
    title: "HbA1c to Estimated Average Glucose (eAG) Converter",
    description: "Convert your 3-month HbA1c percentage into daily estimated blood glucose in mg/dL and mmol/L using the ADA clinical trial formula.",
    badge: "Clinical Formula (ADAG)",
    icon: "🩸",
    features: ["Two-way conversion (HbA1c ⇄ mg/dL)", "Prediabetes & Diabetes thresholds", "Fasting vs HbA1c explanation"]
  },
  {
    slug: "normal-range",
    title: "Biomarker Normal Range Reference Directory",
    description: "Instant search and reference ranges for 40+ common Indian laboratory tests including CBC, Thyroid (TSH), Liver (SGPT), Kidney (Creatinine) and Vitamins.",
    badge: "40+ Diagnostic Markers",
    icon: "🔍",
    features: ["Instant search & filter", "Indian laboratory standard ranges", "Plain-language clinical meaning"]
  }
];
---

<Layout 
  title="Free Clinical Health Calculators & Lab Tools | HealthSaral"
  description="Free evidence-based health calculators and lab tools for Indian patients. Asian Indian BMI calculator, HbA1c to blood sugar converter, and diagnostic reference range directory."
>
  <Header />

  <main class="flex-grow">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-mesh-gradient pt-16 pb-16 px-4 sm:px-6 lg:px-8 border-b border-hairline">
      <div class="w-full max-w-4xl mx-auto text-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-primary/5 border border-primary/10 text-primary text-[10px] sm:text-[11px] font-mono rounded-full uppercase tracking-wider mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span>Free Interactive Diagnostic Tools</span>
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-primary tracking-tight mb-4 text-balance">
          Evidence-Based Health Calculators &amp; Reference Tools
        </h1>
        <p class="text-sm sm:text-base text-muted max-w-2xl mx-auto leading-relaxed text-pretty">
          Accurate, clinical-grade health calculators calibrated for Indian physiological benchmarks and dietary realities. Instant, free, and privacy-protected.
        </p>
      </div>
    </section>

    <!-- Tools Grid -->
    <section class="py-16 md:py-20 bg-canvas px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8">
          {tools.map((tool) => (
            <div class="group border border-hairline bg-canvas rounded-2xl p-6 sm:p-7 shadow-sm hover:shadow-md-stacked transition-all duration-300 hover:border-primary/20 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl">{tool.icon}</span>
                  <span class="text-[10px] font-mono text-primary bg-primary/5 border border-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wide">
                    {tool.badge}
                  </span>
                </div>
                
                <h2 class="text-lg sm:text-xl font-display font-bold text-primary mb-2.5 leading-snug group-hover:text-accent transition-colors">
                  {tool.title}
                </h2>
                
                <p class="text-xs sm:text-sm text-muted leading-relaxed mb-6 text-pretty">
                  {tool.description}
                </p>

                <ul class="space-y-2 mb-6 border-t border-hairline/60 pt-4" role="list">
                  {tool.features.map(f => (
                    <li class="flex items-center gap-2 text-xs text-muted">
                      <span class="text-primary font-bold">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a 
                href={`/tools/${tool.slug}/`}
                class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-primary/5 hover:bg-primary text-primary hover:text-white border border-primary/20 hover:border-primary font-sans font-semibold text-xs rounded-full transition-all duration-200"
              >
                Launch Calculator &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Conversion Callout -->
    <section class="py-14 bg-primary/5 border-t border-hairline text-center px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-mono text-primary/80 uppercase tracking-widest block mb-2">FULL LAB ANALYSIS</span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-primary mb-3">
          Have an actual diagnostic lab report?
        </h2>
        <p class="text-sm sm:text-base text-muted mb-6 max-w-xl mx-auto">
          Don't type numbers one by one. Securely upload your blood test PDF or photo and let HealthSaral decode every marker with personalized Indian food recommendations.
        </p>
        <a 
          href="/#upload-section" 
          class="inline-block px-7 py-3 bg-accent hover:bg-accent/90 text-white font-sans font-semibold text-xs sm:text-sm rounded-full shadow-md hover:scale-[1.02] transition-all"
        >
          Analyze Complete Report Free &rarr;
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "HealthSaral Clinical Health Calculators & Lab Tools",
  "url": "https://healthsaral.in/tools/",
  "description": "Evidence-based health calculators and lab reference tools for Indian patients.",
  "publisher": {
    "@type": "Organization",
    "name": "HealthSaral",
    "url": "https://healthsaral.in"
  }
}
</script>
