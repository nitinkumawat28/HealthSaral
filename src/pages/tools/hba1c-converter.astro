---
import Layout from '../../frontend/layouts/Layout.astro';
import Header from '../../frontend/components/Header.astro';
import Footer from '../../frontend/components/Footer.astro';
import BlogShareBar from '../../frontend/components/BlogShareBar.astro';

const title = "HbA1c to Blood Sugar Converter — eAG Calculator | HealthSaral";
const description = "Convert HbA1c percentage to estimated average glucose (eAG) in mg/dL and mmol/L. Understand normal, prediabetes, and diabetes ranges with Indian food tips.";
const pageUrl = "https://healthsaral.in/tools/hba1c-converter/";

const hba1cTable = [
  { hba1c: "5.0%", mgdl: 97, mmoll: 5.4, status: "Normal" },
  { hba1c: "5.5%", mgdl: 111, mmoll: 6.2, status: "Normal" },
  { hba1c: "5.7%", mgdl: 117, mmoll: 6.5, status: "Prediabetes Threshold" },
  { hba1c: "6.0%", mgdl: 126, mmoll: 7.0, status: "Prediabetes" },
  { hba1c: "6.4%", mgdl: 137, mmoll: 7.6, status: "High Prediabetes" },
  { hba1c: "6.5%", mgdl: 140, mmoll: 7.8, status: "Diabetes Diagnosis" },
  { hba1c: "7.0%", mgdl: 154, mmoll: 8.6, status: "Moderate Control Target" },
  { hba1c: "7.5%", mgdl: 169, mmoll: 9.4, status: "Elevated" },
  { hba1c: "8.0%", mgdl: 183, mmoll: 10.2, status: "Action Required" },
  { hba1c: "9.0%", mgdl: 212, mmoll: 11.8, status: "Poor Control" },
  { hba1c: "10.0%", mgdl: 240, mmoll: 13.4, status: "High Risk" }
];
---

<Layout title={title} description={description}>
  <Header />

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-0">
    <ol class="flex flex-wrap items-center gap-1.5 text-xs font-mono text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-muted/50" aria-hidden="true">›</li>
      <li><a href="/tools/" class="hover:text-primary transition-colors">Tools</a></li>
      <li class="text-muted/50" aria-hidden="true">›</li>
      <li><span class="text-primary/80" aria-current="page">HbA1c to Blood Sugar Converter</span></li>
    </ol>
  </nav>

  <main class="flex-grow">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-mesh-gradient pt-10 pb-12 px-4 sm:px-6 lg:px-8 border-b border-hairline">
      <div class="w-full max-w-3xl mx-auto text-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-primary/5 border border-primary/10 text-primary text-[10px] sm:text-[11px] font-mono rounded-full uppercase tracking-wider mb-4">
          <span>Clinical ADAG Linear Regression Formula</span>
        </span>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-primary tracking-tight mb-3 text-balance">
          HbA1c to Average Blood Sugar (eAG) Converter
        </h1>
        <p class="text-xs sm:text-sm text-muted max-w-xl mx-auto leading-relaxed">
          Translate your 3-month glycated hemoglobin percentage into an intuitive 24-hour estimated average glucose level (in mg/dL &amp; mmol/L) matching daily glucometer readings.
        </p>
      </div>
    </section>

    <!-- Interactive Converter -->
    <section class="py-12 bg-canvas px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto grid md:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Input Form -->
        <div class="md:col-span-6 bg-canvas-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-sm">
          <h2 class="text-base font-display font-bold text-primary mb-1">Enter Lab Values</h2>
          <p class="text-xs text-muted mb-6">Type either your HbA1c percentage or glucometer average to calculate instantly.</p>

          <div class="space-y-6">
            <!-- Mode 1: HbA1c -> Glucose -->
            <div>
              <div class="flex justify-between items-center mb-1.5">
                <label for="hba1c-input" class="text-xs font-mono text-primary font-semibold uppercase tracking-wider">
                  HbA1c Level (%)
                </label>
                <span id="hba1c-live-val" class="text-xs font-mono font-bold text-primary">6.2%</span>
              </div>
              <input 
                type="number" 
                id="hba1c-input" 
                step="0.1" 
                min="4.0" 
                max="16.0" 
                value="6.2" 
                class="w-full px-3.5 py-2.5 bg-canvas border border-hairline rounded-xl text-base font-mono font-bold text-primary focus:outline-none focus:ring-2 focus:ring-primary/20 mb-3"
              />
              <input 
                type="range" 
                id="hba1c-slider" 
                step="0.1" 
                min="4.0" 
                max="14.0" 
                value="6.2" 
                class="w-full accent-primary cursor-pointer"
              />
            </div>

            <!-- Divider -->
            <div class="relative flex items-center justify-center my-2">
              <div class="border-t border-hairline w-full"></div>
              <span class="bg-canvas-soft px-3 text-[10px] font-mono text-muted uppercase">or convert backward</span>
            </div>

            <!-- Mode 2: Glucose -> HbA1c -->
            <div>
              <label for="glucose-input" class="block text-xs font-mono text-muted uppercase tracking-wider mb-1.5">
                Average Daily Blood Sugar (mg/dL)
              </label>
              <input 
                type="number" 
                id="glucose-input" 
                step="1" 
                min="50" 
                max="450" 
                placeholder="e.g. 131" 
                class="w-full px-3.5 py-2.5 bg-canvas border border-hairline rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 text-ink"
              />
            </div>
          </div>
        </div>

        <!-- Right Column: Live Diagnostic Result -->
        <div class="md:col-span-6 bg-canvas border border-hairline rounded-2xl p-6 sm:p-7 shadow-md-stacked flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-muted uppercase tracking-wider block mb-1">Estimated Average Glucose (eAG)</span>
            
            <div class="flex items-baseline gap-3 mb-2">
              <span id="glucose-result-mgdl" class="text-4xl sm:text-5xl font-display font-bold text-primary">131</span>
              <span class="text-sm font-mono text-muted">mg/dL</span>
              <span id="glucose-result-mmoll" class="text-xs font-mono text-muted">(7.3 mmol/L)</span>
            </div>

            <div class="mb-4">
              <span id="status-badge" class="inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wide bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
                Prediabetes Range (5.7% – 6.4%)
              </span>
            </div>

            <!-- Interpretation box -->
            <div id="status-explanation" class="text-xs text-ink/90 leading-relaxed space-y-2 bg-canvas-soft border border-hairline rounded-xl p-4 mb-6">
              <p>
                An HbA1c of <strong>6.2%</strong> means roughly 6.2% of your hemoglobin has glucose bonded to it, reflecting an average blood sugar of <strong>131 mg/dL</strong> over the past 90 days.
              </p>
              <p>
                This falls in the <strong>Prediabetes</strong> category. Lifestyle modifications—such as limiting refined carbohydrates, adding fenugreek (methi dana) and regular brisk walks—can prevent or reverse progression to Type 2 diabetes.
              </p>
            </div>
          </div>

          <!-- Bottom Action -->
          <div class="border-t border-hairline pt-5">
            <a 
              href="/#upload-section" 
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-accent hover:bg-accent/90 text-white font-sans font-semibold text-xs sm:text-sm rounded-full shadow-md transition-all"
            >
              Analyze Complete Blood Sugar Report Free &rarr;
            </a>
            <span class="block text-center text-[10.5px] font-mono text-muted mt-2">
              Upload PDF or photo from Lal PathLabs, Thyrocare, SRL &amp; get Indian diet plan
            </span>
          </div>
        </div>

      </div>
    </section>

    <!-- Reference Table -->
    <section class="py-14 bg-canvas-soft border-t border-hairline px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xl font-display font-bold text-primary mb-2">HbA1c to Average Glucose Conversion Chart</h2>
        <p class="text-xs sm:text-sm text-muted mb-6">
          Reference table calculated using the standard <em>A1c-Derived Average Glucose (ADAG)</em> study equation: <code>eAG (mg/dL) = 28.7 &times; HbA1c - 46.7</code>.
        </p>

        <div class="overflow-x-auto bg-canvas border border-hairline rounded-2xl shadow-sm mb-8">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-hairline bg-primary/5 text-primary font-mono">
                <th class="py-3 px-4">HbA1c (%)</th>
                <th class="py-3 px-4">eAG (mg/dL)</th>
                <th class="py-3 px-4">eAG (mmol/L)</th>
                <th class="py-3 px-4">Clinical Interpretation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {hba1cTable.map((row) => (
                <tr class="hover:bg-primary/[0.02] transition-colors">
                  <td class="py-3 px-4 font-mono font-bold text-primary">{row.hba1c}</td>
                  <td class="py-3 px-4 font-mono font-semibold">{row.mgdl} mg/dL</td>
                  <td class="py-3 px-4 font-mono text-muted">{row.mmoll} mmol/L</td>
                  <td class="py-3 px-4">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-mono font-medium ${
                      row.status.includes('Normal') 
                        ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400' 
                        : row.status.includes('Prediabetes') 
                        ? 'bg-amber-500/10 text-amber-700 dark:text-amber-400' 
                        : 'bg-rose-500/10 text-rose-700 dark:text-rose-400'
                    }`}>
                      {row.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Clinical Guidelines -->
        <div class="prose dark:prose-invert prose-sm font-sans text-ink leading-relaxed">
          <h3 class="text-lg font-display font-bold text-primary mb-3">Why does Fasting Glucose differ from HbA1c?</h3>
          <p>
            Patients frequently wonder why their <strong>Fasting Blood Sugar (FBS)</strong> may be 105 mg/dL while their HbA1c indicates an average of 140 mg/dL.
          </p>
          <ul>
            <li><strong>Fasting Blood Sugar</strong> captures a single snapshot in time after 8–10 hours without food.</li>
            <li><strong>Post-Meal (Postprandial) Spikes:</strong> In India, meals rich in carbohydrates (rice, roti, dal, potatoes) frequently cause steep postprandial sugar spikes that last 2–3 hours. A fasting test misses these completely.</li>
            <li><strong>HbA1c</strong> measures the total cumulative glucose exposure over the entire 90-day lifespan of your red blood cells, accurately capturing both fasting and post-meal glucose fluctuations.</li>
          </ul>

          <h3 class="text-lg font-display font-bold text-primary mt-6 mb-3">Target Recommendations for Indian Patients</h3>
          <p>
            According to the <em>Research Society for the Study of Diabetes in India (RSSDI)</em> and <em>ICMR</em>:
          </p>
          <ul>
            <li><strong>Non-Diabetic Adults:</strong> Maintain HbA1c below <strong>5.7%</strong>.</li>
            <li><strong>Prediabetes:</strong> Between <strong>5.7% and 6.4%</strong>. Requires urgent dietary and physical intervention.</li>
            <li><strong>Diagnosed Type 2 Diabetes:</strong> General target is <strong>&lt; 7.0%</strong> (eAG &lt; 154 mg/dL) to prevent microvascular complications in kidneys, eyes, and nerves.</li>
          </ul>
        </div>

        <!-- Share Bar -->
        <div class="mt-8">
          <BlogShareBar title="HbA1c to Blood Sugar Converter — eAG Calculator" url={pageUrl} />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const hba1cInput = document.getElementById('hba1c-input');
  const hba1cSlider = document.getElementById('hba1c-slider');
  const hba1cLiveVal = document.getElementById('hba1c-live-val');
  const glucoseInput = document.getElementById('glucose-input');

  const glucoseResultMgdl = document.getElementById('glucose-result-mgdl');
  const glucoseResultMmoll = document.getElementById('glucose-result-mmoll');
  const statusBadge = document.getElementById('status-badge');
  const statusExplanation = document.getElementById('status-explanation');

  function updateFromA1c(a1c) {
    if (isNaN(a1c) || a1c <= 0) return;
    
    // ADAG formula: eAG (mg/dL) = (28.7 * A1C) - 46.7
    const mgdl = Math.round((28.7 * a1c) - 46.7);
    const mmoll = ((mgdl + 46.7) / 28.7 / 18.0182).toFixed(1);

    glucoseResultMgdl.textContent = mgdl;
    glucoseResultMmoll.textContent = `(${mmoll} mmol/L)`;
    hba1cLiveVal.textContent = a1c.toFixed(1) + '%';
    hba1cInput.value = a1c.toFixed(1);
    hba1cSlider.value = a1c;
    glucoseInput.value = mgdl;

    // Evaluate Risk
    if (a1c < 5.7) {
      statusBadge.textContent = 'Normal Range (< 5.7%)';
      statusBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wide bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
      statusExplanation.innerHTML = `<p>An HbA1c of <strong>${a1c.toFixed(1)}%</strong> indicates excellent glucose control with an estimated average blood sugar of <strong>${mgdl} mg/dL</strong>. This falls safely within the non-diabetic range.</p>`;
    } else if (a1c <= 6.4) {
      statusBadge.textContent = 'Prediabetes Range (5.7% – 6.4%)';
      statusBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wide bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
      statusExplanation.innerHTML = `<p>An HbA1c of <strong>${a1c.toFixed(1)}%</strong> (${mgdl} mg/dL eAG) indicates <strong>Prediabetes</strong>. In India, over 136 million people live with prediabetes. With early diet changes (low GI grains, fenugreek, daily walking), this stage is fully reversible.</p>`;
    } else if (a1c <= 7.0) {
      statusBadge.textContent = 'Diabetes — Fair Control (6.5% – 7.0%)';
      statusBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wide bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20';
      statusExplanation.innerHTML = `<p>An HbA1c of <strong>${a1c.toFixed(1)}%</strong> (${mgdl} mg/dL eAG) meets the clinical threshold for Type 2 diabetes. For diagnosed patients, staying near or under 7.0% is the standard clinical goal to safeguard kidneys and heart health.</p>`;
    } else {
      statusBadge.textContent = 'Diabetes — High / Uncontrolled (> 7.0%)';
      statusBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wide bg-rose-600/10 text-rose-700 dark:text-rose-400 border border-rose-600/20';
      statusExplanation.innerHTML = `<p>An HbA1c of <strong>${a1c.toFixed(1)}%</strong> (${mgdl} mg/dL eAG) indicates significantly elevated blood glucose over the past 3 months. Consult your physician or diabetologist for medical review and medication optimization.</p>`;
    }
  }

  function updateFromGlucose(glucose) {
    if (isNaN(glucose) || glucose <= 0) return;
    // Reverse ADAG formula: A1C = (mg/dL + 46.7) / 28.7
    const a1c = (glucose + 46.7) / 28.7;
    updateFromA1c(parseFloat(a1c.toFixed(1)));
  }

  hba1cInput.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    if (!isNaN(val)) updateFromA1c(val);
  });

  hba1cSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    if (!isNaN(val)) updateFromA1c(val);
  });

  glucoseInput.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    if (!isNaN(val)) updateFromGlucose(val);
  });

  // Init
  updateFromA1c(6.2);
</script>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": ["WebApplication", "MedicalWebPage"],
  "name": "HbA1c to Blood Sugar Converter (eAG)",
  "url": "https://healthsaral.in/tools/hba1c-converter/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "WebBrowser",
  "description": "Convert HbA1c percentage to estimated average glucose (eAG) in mg/dL and mmol/L using the clinical ADAG formula.",
  "publisher": {
    "@type": "Organization",
    "name": "HealthSaral",
    "url": "https://healthsaral.in"
  },
  "medicalAudience": {
    "@type": "PatientAudience",
    "audienceType": "Patient"
  }
}
</script>
