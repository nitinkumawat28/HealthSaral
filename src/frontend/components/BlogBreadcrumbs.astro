---
interface Props {
  title: string;
  slug: string;
}
const { title, slug } = Astro.props;
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://healthsaral.in/" },
    { "@type": "ListItem", "position": 2, "name": "Patient Guides", "item": "https://healthsaral.in/blog/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": `https://healthsaral.in/blog/${slug}/` }
  ]
});
---

<nav aria-label="Breadcrumb" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-0">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs font-mono text-muted">
    <li>
      <a href="/" class="hover:text-primary transition-colors">Home</a>
    </li>
    <li class="text-muted/50" aria-hidden="true">›</li>
    <li>
      <a href="/blog/" class="hover:text-primary transition-colors">Patient Guides</a>
    </li>
    <li class="text-muted/50" aria-hidden="true">›</li>
    <li>
      <span class="text-primary/80 truncate max-w-[200px] sm:max-w-none inline-block align-bottom" aria-current="page">{title}</span>
    </li>
  </ol>
</nav>

<script type="application/ld+json" set:html={breadcrumbSchema} />
