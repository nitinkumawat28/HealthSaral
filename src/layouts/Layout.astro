---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "HealthSaral — AI Lab Report Analyzer | Understand Any Blood Test Instantly", 
	description = "Free AI-powered lab report analyzer. Upload any blood test or medical report and get a clear, personalized explanation in simple language — no jargon, no guesswork."
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://healthsaral.in').href;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Deferred Third-Party Scripts Loading (Google Tag Manager & Google AdSense) -->
		<script is:inline>
			(() => {
				let scriptsLoaded = false;

				function loadDeferredScripts() {
					if (scriptsLoaded) return;
					scriptsLoaded = true;

					// Load Google Analytics (gtag.js)
					const gtmScript = document.createElement('script');
					gtmScript.src = "https://www.googletagmanager.com/gtag/js?id=G-5L34B7RTPY";
					gtmScript.async = true;
					document.head.appendChild(gtmScript);

					// Load Google AdSense (adsbygoogle.js)
					const adsScript = document.createElement('script');
					adsScript.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1781114260611546";
					adsScript.async = true;
					adsScript.crossOrigin = "anonymous";
					document.head.appendChild(adsScript);

					// Clean up event listeners
					triggerEvents.forEach(event => {
						window.removeEventListener(event, loadDeferredScripts, { passive: true });
					});
				}

				// Immediately set up global gtag stub to prevent reference errors
				window.dataLayer = window.dataLayer || [];
				window.gtag = function() {
					window.dataLayer.push(arguments);
				};
				window.gtag('js', new Date());
				window.gtag('config', 'G-5L34B7RTPY');

				// Listen for common user interaction events before loading scripts
				const triggerEvents = ['touchstart', 'mousemove', 'scroll', 'keydown', 'click'];
				triggerEvents.forEach(event => {
					window.addEventListener(event, loadDeferredScripts, { passive: true });
				});
			})();
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="HealthSaral" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/og-image.png', 'https://healthsaral.in').href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="HealthSaral — AI Lab Report Analyzer Dashboard" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og-image.png', 'https://healthsaral.in').href} />
		
		<!-- Google Fonts: Fraunces (Headlines), Inter (Body), JetBrains Mono (Clinical labels) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
		<link rel="dns-prefetch" href="https://fonts.gstatic.com" />
		
		<!-- Load Google Fonts stylesheet asynchronously to avoid render blocking (improves FCP/LCP) -->
		<link 
			rel="preload" 
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" 
			as="style" 
			onload="this.onload=null;this.rel='stylesheet'" 
		/>
		<noscript>
			<link 
				href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" 
				rel="stylesheet" 
			/>
		</noscript>
		
		<!-- Theme initialization to prevent FOUC -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-canvas-soft text-ink font-sans antialiased min-h-screen flex flex-col">
		<slot />
	</body>
</html>
